{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 1,
    "margin": 0,
    "modules-left": ["dwl/tags", "dwl/window"],
    "modules-center": [],
    "modules-right": ["mpd", "custom/weather", "wireplumber", "network", "cpu", "memory", "temperature", "battery", "disk", "custom/updates", "tray", "clock", "idle_inhibitor"],

    "dwl/window": {
    "format": " {title}",
    "max-length": 100,
    "rewrite": {
       "(.*) — LibreWolf": "🌎 $1",
       "(.*) — LibreWolf Private Browsing": "󰗹 $1",
       "(.*) - VIM": " $1",
        }
    },

    "mpd": {
        "format": "{stateIcon} {title} - {artist}",
        "format-disconnected": "",
        "format-stopped": "",
        "interval": 30,
        //"max-length": 40,
        //"min-length": 40,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ", // Icon grayed out when "random" is off
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "Album: {album}",
        "tooltip-format-disconnected": "mpd disconnected",
        "on-click": "rmpc togglepause"
        //"tooltip-format-stopped": "Idle"
    },

    "custom/weather": {
        "exec": "curl 'https://wttr.in/?format=1'",
        "interval": 3600,
        "format": "{}",
        "on-click": "foot -H curl https://wttr.in/",
        "class": "weather"
    },

    "custom/updates": {
        "format": "󰚰 {}",
        "exec": "checkupdates | wc -l",
        "interval": 3600,
        "signal": 8,
        "class": "updates"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈",
            "deactivated": "󰈉"
        },
        "tooltip": true
    },

    "clock": {
        "format": "󰥔 {:%H:%M %d-%m-%Y}",
        // "format-alt": "󰃮 {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "on-click-right": "mode",
            "format": {
                "months":     "<span color='#d3c6aa'><b>{}</b></span>",
                "days":       "<span color='#e67e80'>{}</span>",
                "weeks":      "<span color='#a7c080'><b>W{}</b></span>",
                "weekdays":   "<span color='#7fbbb3'><b>{}</b></span>",
                "today":      "<span color='#dbbc7f'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "format": "󰘚 {usage}%",
        "tooltip": true,
        "interval": 3,
    },

    "memory": {
        "format": "󰍛 {}%",
        "interval": 3,
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "network": {
        "format-wifi": "󰖩 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 (No IP)",
        "format-disconnected": "󰖪 Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname}: {ipaddr}",
        // "on-click": "foot nmtui"
    },

    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": ["", "", ""]
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "disk": {
        "interval": 3600,
        "format": "󰋊 {percentage_used}%",
        //"format": "󰋊 {specific_used:0.0f}GiB/{specific_total:0.0f}GiB",
        "path": "/",
        "unit": "GiB"
        // "on-click": "alacritty gdu /"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 5
    }
}

